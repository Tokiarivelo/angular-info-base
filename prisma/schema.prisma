generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Chapter {
  id                  String                @id
  courseId            String
  title               String
  description         String?
  content             String?
  livePreviewUrl      String?
  order               Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  Course              Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  Checklist           Checklist[]
  Quiz                Quiz[]
  UserChapterProgress UserChapterProgress[]

  @@index([courseId])
  @@index([order])
}

model Checklist {
  id            String          @id
  title         String
  description   String?
  ownerId       String
  chapterId     String?
  createdAt     DateTime        @default(now())
  Chapter       Chapter?        @relation(fields: [chapterId], references: [id])
  User          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ChecklistItem ChecklistItem[]

  @@index([chapterId])
  @@index([ownerId])
}

model ChecklistItem {
  id          String    @id
  checklistId String
  title       String
  done        Boolean   @default(false)
  order       Int?
  notes       String?
  updatedAt   DateTime
  Checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
}

model Course {
  id                String              @id
  title             String
  description       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  Chapter           Chapter[]
  CourseEnrollment  CourseEnrollment[]
  EnrollmentRequest EnrollmentRequest[]

  @@index([title])
}

model CourseEnrollment {
  id         String   @id
  userId     String
  courseId   String
  assignedBy String?
  createdAt  DateTime @default(now())
  Course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([userId])
}

model CourseRequest {
  id          String              @id
  userId      String
  title       String
  description String?
  reason      String?
  status      CourseRequestStatus @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime
  User        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
}

model EnrollmentRequest {
  id         String                  @id
  userId     String
  courseId   String
  message    String?
  status     EnrollmentRequestStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime
  Course     Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  User       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([status])
  @@index([userId])
}

model Quiz {
  id             String           @id
  chapterId      String
  title          String
  description    String?
  passingScore   Int              @default(70)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  Chapter        Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  QuizQuestion   QuizQuestion[]
  QuizSubmission QuizSubmission[]

  @@index([chapterId])
}

model QuizQuestion {
  id            String   @id
  quizId        String
  question      String
  options       String[]
  correctAnswer Int
  explanation   String?
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  Quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([order])
  @@index([quizId])
}

model QuizSubmission {
  id        String   @id
  userId    String
  quizId    String
  answers   Int[]
  score     Int
  passed    Boolean
  createdAt DateTime @default(now())
  Quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([userId])
  @@index([userId, quizId])
}

model Screenshot {
  id                  String               @id
  url                 String
  publicId            String?
  userId              String
  progressId          String?
  caption             String?
  createdAt           DateTime             @default(now())
  UserChapterProgress UserChapterProgress? @relation(fields: [progressId], references: [id], onDelete: Cascade)
  User                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([progressId])
  @@index([userId])
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                  String                @id
  email               String                @unique
  emailVerified       DateTime?
  name                String?
  image               String?
  password            String?
  role                UserRole              @default(USER)
  createdAt           DateTime              @default(now())
  Account             Account[]
  Checklist           Checklist[]
  CourseEnrollment    CourseEnrollment[]
  CourseRequest       CourseRequest[]
  EnrollmentRequest   EnrollmentRequest[]
  QuizSubmission      QuizSubmission[]
  Screenshot          Screenshot[]
  Session             Session[]
  UserChapterProgress UserChapterProgress[]
}

model UserChapterProgress {
  id            String       @id
  userId        String
  chapterId     String
  repositoryUrl String?
  websiteUrl    String?
  completed     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime
  Screenshot    Screenshot[]
  Chapter       Chapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  User          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@index([chapterId])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum CourseRequestStatus {
  PENDING
  APPROVED
  REJECTED
  IN_PROGRESS
}

enum EnrollmentRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  USER
  ADMIN
}
